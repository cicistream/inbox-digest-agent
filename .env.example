# Outlook / 任意邮箱（推荐：IMAP，无需 OAuth）
# Outlook.com 或 Office 365：IMAP_HOST=outlook.office365.com，并到账户安全里开启 IMAP、必要时使用应用密码
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=
IMAP_PORT=

# Gmail（可选，若使用 Gmail 且已配置 OAuth2 则优先用 Gmail API）
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# Qwen / 总结邮件（与项目根 .env 一致，可用 DashScope 通义千问）
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=

# Notion（通过 MCP：npx @notionhq/notion-mcp-server，任填其一即可）
NOTION_TOKEN=
NOTION_API_KEY=
NOTION_PAGE_ID=

# 可选：发件人白名单逗号分隔，留空则不过滤
EMAIL_ALLOW_SENDERS=
# 可选：只处理最近 N 天的邮件
EMAIL_DAYS=7
