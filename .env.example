# Outlook OAuth2（推荐，无需应用密码）
# Azure 应用注册 → 概述 → 应用程序(客户端) ID
OUTLOOK_CLIENT_ID=
# 运行 pnpm run outlook:auth 获取后粘贴到下面
OUTLOOK_REFRESH_TOKEN=
# 可选：若为“Web”应用类型则填客户端密码
OUTLOOK_CLIENT_SECRET=

# Outlook IMAP（备选，需应用密码）
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993

# Qwen / 总结邮件
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-turbo

# Notion（MCP）
NOTION_TOKEN=
NOTION_PAGE_ID=

# 可选
# EMAIL_DAYS=7
# EMAIL_ALLOW_SENDERS=
